daily_arrivals <- numeric(30)
for (day in 1:30) {
start_hour <- (day - 1) * 24 + 1
end_hour <- day * 24
day_arrival <- sum(simulated_arrival[start_hour:end_hour])
daily_arrivals[day] <- day_arrival
}
daily_arrivals
