library(tidyverse)
network_data <- read.csv("network.csv")
network_data
network_data |> autoplot()
network_data |>
ggplot(aes(x = User)) + geom_col() + labs(title = "Network Analysis")
network_data |>
ggplot(aes(network_data)) + geom_col() + labs(title = "Network Analysis")
network_data |>
ggplot(aes(network_data$User)) + geom_col() + labs(title = "Network Analysis")
ggplot(aes(x = network_data)) + geom_bar()
ggplot(network_data  + geom_bar() + labs(title = "Social Media Network Analysis")
ggplot(network_data aes(x = network_data$User) + geom_bar() + labs(title = "Social Media Network Analysis")
ggplot(network_data aes(x = user_labels, y = adj_matrix) + geom_bar() + labs(title = "Social Media Network Analysis")
ggplot(network_data aes(x = user_labels ) + geom_bar() + labs(title = "Social Media Network Analysis")
ggplot(network_data, aes(x = user_labels ) + geom_bar() + labs(title = "Social Media Network Analysis")
ggplot(network_data, aes(x = user_labels )) + geom_bar() + labs(title = "Social Media Network Analysis")
